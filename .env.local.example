# Required production Firebase Web SDK configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Firebase features.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional server-only response rewriting. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional free-tier nutrition estimation providers. Server-only; never use
# NEXT_PUBLIC_. Text estimation falls back in this order when keys exist.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
