# Copy this file to .env.local and fill in your Firebase project's values.
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# All of these are safe to expose to the browser (that's what NEXT_PUBLIC_ means) —
# Firestore/Storage/Auth access is still enforced server-side by firestore.rules /
# storage.rules, not by hiding these values.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
# Required for push notifications (src/lib/firebase/messaging.ts); the app
# runs fine without it, notifications are just disabled.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- AI Coach (Phase 3) ---------------------------------------------------
# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the browser.
# Used exclusively by src/app/api/ai/coach/route.ts, which the Claude
# provider (src/lib/ai/providers/claudeProvider.ts) calls. Without this set,
# the app runs fine — the API route returns a clear 503 and every business
# decision (the engines in src/lib/engines) still works, since they never
# depend on the LLM being available.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

