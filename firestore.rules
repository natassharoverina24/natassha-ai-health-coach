rules_version = '2';

/**
 * Security model: every document in every collection carries a `userId`
 * (or, for `users`/`settings`, uses the uid as the document id). A user
 * may only read or write their own data — no document is ever readable
 * by anyone else. There are no public/shared collections in this app.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsIncomingDoc() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingDoc() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsUpdatedDoc() {
      return ownsExistingDoc()
        && request.resource.data.userId == resource.data.userId;
    }

    function activeDisruptionOwnerAndId(disruptionId) {
      return request.auth != null
        && request.auth.uid == request.resource.data.userId
        && disruptionId
          == request.resource.data.userId
            + "__"
            + request.resource.data.date;
    }

    function activeDisruptionCommonFieldsAreValid() {
      let data = request.resource.data;
      return data.keys().hasAll([
          "userId", "date", "type", "status", "startedAt"
        ])
        && data.userId is string
        && data.date is string
        && data.startedAt is string
        && data.type in [
          "working-late",
          "migraine",
          "feeling-unwell",
          "pms",
          "travelling",
          "event-or-reception",
          "missed-workout",
          "skipped-meal"
        ]
        && data.status in ["active", "cleared"]
        && (!data.keys().hasAny(["note"])
          || (data.note is string
            && data.note.size() > 0
            && data.note.size() <= 240))
        && (!data.keys().hasAny(["createdAt"])
          || data.createdAt is timestamp)
        && (!data.keys().hasAny(["updatedAt"])
          || data.updatedAt is timestamp);
    }

    function activeDisruptionTypeFieldsAreValid() {
      let data = request.resource.data;
      return
        (data.type == "working-late"
          && data.keys().hasOnly([
            "userId", "date", "type", "status", "startedAt", "note",
            "expectedEndAt", "clearedAt", "createdAt", "updatedAt"
          ])
          && data.expectedEndAt is string)
        || (data.type == "travelling"
          && data.keys().hasOnly([
            "userId", "date", "type", "status", "startedAt", "note",
            "affectedSlot", "clearedAt", "createdAt", "updatedAt"
          ])
          && data.affectedSlot in [
            "breakfast", "lunch", "snack", "dinner", "workout"
          ])
        || (data.type == "event-or-reception"
          && data.keys().hasOnly([
            "userId", "date", "type", "status", "startedAt", "note",
            "affectedMealSlot", "clearedAt", "createdAt", "updatedAt"
          ])
          && data.affectedMealSlot in ["lunch", "dinner", "snack"])
        || (data.type == "skipped-meal"
          && data.keys().hasOnly([
            "userId", "date", "type", "status", "startedAt", "note",
            "skippedMealSlot", "skippedAt", "clearedAt",
            "createdAt", "updatedAt"
          ])
          && data.skippedMealSlot in [
            "breakfast", "lunch", "snack", "dinner"
          ]
          && data.skippedAt is string)
        || (data.type in [
            "migraine", "feeling-unwell", "pms", "missed-workout"
          ]
          && data.keys().hasOnly([
            "userId", "date", "type", "status", "startedAt", "note",
            "clearedAt", "createdAt", "updatedAt"
          ]));
    }

    function activeDisruptionStatusFieldsAreValid() {
      let data = request.resource.data;
      return (data.status == "active"
          && !data.keys().hasAny(["clearedAt"]))
        || (data.status == "cleared"
          && data.clearedAt is string);
    }

    function validActiveDisruption(disruptionId) {
      return activeDisruptionOwnerAndId(disruptionId)
        && activeDisruptionCommonFieldsAreValid()
        && activeDisruptionTypeFieldsAreValid()
        && activeDisruptionStatusFieldsAreValid();
    }

    // users/{uid} — profile document, id === uid
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // settings/{uid} — settings document, id === uid
    match /settings/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && ownsIncomingDoc();
      allow update: if isOwner(userId) && ownsUpdatedDoc();
    }

    // Collections keyed by an auto-generated id with a `userId` field.
    match /weights/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /waists/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /meals/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /meal_photos/{docId} {
      // Legacy metadata is readable/deletable by its owner for rollback and
      // cleanup, but the ephemeral analysis flow never creates or updates it.
      allow read, delete: if ownsExistingDoc();
      allow create, update: if false;
    }

    match /supplements/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /supplement_logs/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /water_logs/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /timeline_completions/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /active_disruptions/{disruptionId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if request.resource.data.status == "active"
        && validActiveDisruption(disruptionId);
      allow update: if ownsUpdatedDoc()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.date == resource.data.date
        && validActiveDisruption(disruptionId);
    }

    match /workouts/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /sleep_logs/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /motivations/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /shopping/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /reports/{docId} {
      // Reports are system/AI-generated (see src/lib/db/reports.repository.ts);
      // clients may read their own but never write/delete directly.
      allow read: if ownsExistingDoc();
      allow create, update, delete: if false;
    }

    match /cycles/{docId} {
      allow read, delete: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update: if ownsUpdatedDoc();
    }

    match /ai_logs/{docId} {
      // Append-only from the client; no edits or deletes once written.
      allow read: if ownsExistingDoc();
      allow create: if ownsIncomingDoc();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
