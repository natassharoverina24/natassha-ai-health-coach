rules_version = '2';

/**
 * Every uploaded file lives under users/{uid}/... (see
 * src/lib/firebase/storage.ts buildMealPhotoPath / buildReportPath).
 * A user may only read/write files under their own uid folder.
 */
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
